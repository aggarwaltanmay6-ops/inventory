# Copy to .env on the deployment server. Replace every placeholder.
DOMAIN=inventory.example.com
DATABASE_PASSWORD=REPLACE_WITH_RANDOM_MIGRATOR_PASSWORD
# Use migrator for initial migrations/seed, then switch this to stride_app.
# Passwords in URLs must be URL-encoded (random hex passwords need no encoding).
DATABASE_URL=postgresql://stride_migrator:REPLACE_WITH_RANDOM_MIGRATOR_PASSWORD@db:5432/stride
