# Development: leave DATABASE_URL unset to use a local embedded PostgreSQL database.
# Production requires PostgreSQL 15+ and HTTPS.
# DATABASE_URL=postgresql://stride:replace-me@localhost:5432/stride
APP_ORIGIN=http://localhost:3000
PGLITE_DIR=.data/stride
# Supply a unique owner username and a password of at least 12 characters to seed.
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=
# Set true to include sample articles, cartons and opening stock on a NEW database.
SEED_DEMO=false
# Use only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
